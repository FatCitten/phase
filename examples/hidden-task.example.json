{
  "id": "example-fix",
  "cwd": "/absolute/path/to/repository-worktree",
  "prompt": "Fix the bug described in TASK.md. Run the public tests, but do not invent requirements you cannot support from repository evidence.",
  "deny_patterns": [
    ".hidden-tests",
    "reference.patch",
    "gold.patch"
  ],
  "hidden_paths": [
    ".hidden-tests"
  ],
  "hidden_copies": [
    {
      "from": "/outside/worktree/hidden_test.py",
      "to": ".hidden-tests/hidden_test.py"
    }
  ],
  "validation_commands": [
    [
      "python",
      ".hidden-tests/hidden_test.py"
    ]
  ],
  "retrieval_mode": "hybrid"
}
